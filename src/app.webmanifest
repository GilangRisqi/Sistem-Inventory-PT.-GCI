{
  "name": "Sistem Daily Reports PT. Garasi Creasindo Indonesia",
  "short_name": "GCI Daily Reports",
  "description": "Progressive Web App untuk Daily Reports PT. Garasi Creasindo Indonesia. Aplikasi modern dengan dukungan offline untuk manajemen bahan baku dan laporan percetakan.",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "id-ID",
  "dir": "ltr",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "categories": ["business", "productivity", "utilities"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",

  "icons": [
    {
      "src": "images/icons/logogci72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "images/icons/logogci96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "images/icons/logogci128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "images/icons/logogci144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "images/icons/logogci152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "images/icons/logogci192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "images/icons/logogci384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "images/icons/logogci512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "images/icons/logogci192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "images/icons/logogci512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "Daily Report",
      "short_name": "Report",
      "description": "Buat laporan harian baru untuk mesin percetakan",
      "url": "/?action=daily-report",
      "icons": [
        {
          "src": "images/icons/shortcut-report.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Inventory Bahan Baku",
      "short_name": "Inventory",
      "description": "Kelola stok dan inventory bahan baku percetakan",
      "url": "/?action=inventory",
      "icons": [
        {
          "src": "images/icons/shortcut-inventory.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Rekap Laporan",
      "short_name": "Rekap",
      "description": "Lihat dan analisis rekap laporan produksi",
      "url": "/?action=rekap",
      "icons": [
        {
          "src": "images/icons/shortcut-rekap.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],

  "screenshots": [
    {
      "src": "images/screenshots/desktop-dashboard.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard utama sistem daily reports dengan tampilan desktop"
    },
    {
      "src": "images/screenshots/mobile-dashboard.png",
      "sizes": "360x640",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tampilan mobile dashboard inventory"
    },
    {
      "src": "images/screenshots/daily-report-form.png",
      "sizes": "360x640",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Form input daily report mesin percetakan"
    },
    {
      "src": "images/screenshots/inventory-management.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Interface manajemen inventory bahan baku"
    }
  ],

  "related_applications": [],
  "prefer_related_applications": false,

  "edge_side_panel": {
    "preferred_width": 400
  },

  "protocol_handlers": [
    {
      "protocol": "web+gci-inventory",
      "url": "/?protocol=%s"
    }
  ],

  "file_handlers": [
    {
      "action": "/import-data",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"],
        "application/vnd.ms-excel": [".xlsx", ".xls"]
      }
    }
  ],

  "share_target": {
    "action": "/share-report",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["image/*", "application/pdf", "text/csv"]
        }
      ]
    }
  }
}
